# ScaleMargin Dispatcher — environment
#
# Copy to .env, fill in the REQUIRED sections, leave the rest alone.
# Deployment guide: docs/deployment/client-deployment.md

PORT=3100

# ─────────────────────────────────────────────────────────────
# 1. ScaleMargin credentials                          REQUIRED
#    From your onboarding email.
# ─────────────────────────────────────────────────────────────
SCALEMARGIN_DISPATCH_SECRET=
SCALEMARGIN_ANALYTICS_SECRET=

# Where to POST analytics when an event has no per-send callback (SES/SNS).
# One URL for all orgs — routing uses the signed campaign_id + organization_id.
# SCALEMARGIN_ANALYTICS_CALLBACK_URL=https://api.scalemargin.example/api/webhooks/campaign-analytics
# Make the URL above win over the one the dispatch payload carries.
# SCALEMARGIN_ANALYTICS_CALLBACK_URL_OVERRIDES_DISPATCH=1

# ─────────────────────────────────────────────────────────────
# 2. Sending                                          REQUIRED
# ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=ses                     # ses | sendgrid

# The address recipients see. MUST be verified with your provider, or every
# send is rejected. The single most common setup failure.
FROM_EMAIL=campaigns@your-domain.com

# --- AWS SES ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=                 # omit both to use an IAM role (EC2/ECS/GKE)
# SES_EVENT_CONFIG_SET=                # required for open/click/bounce tracking

# --- SendGrid ---
# SENDGRID_API_KEY=
# SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=   # base64 ECDSA key; presence enables inbound events

# ─────────────────────────────────────────────────────────────
# 3. Your customer database — read only               REQUIRED
#    Which table and columns: config/dispatch.yaml
# ─────────────────────────────────────────────────────────────
USER_LOOKUP_BACKEND=mock               # mock | mysql | postgres | sqlite | http
# USER_LOOKUP_CONFIG_PATH=./config/dispatch.yaml   # default; mock lookup if missing

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# DB_SSL=true
# DB_FILE=./data/dispatch.sqlite       # sqlite backend only
# DB_ALLOW_EMPTY_PASSWORD=true         # local dev only

# http backend: the token named by `token_env` in config/dispatch.yaml
# PROFILE_API_TOKEN=

# ─────────────────────────────────────────────────────────────
# 4. The dispatcher's own database
#    Separate from DB_* above. Holds variables, campaign history,
#    logs and the event outbox. Migrations run at startup.
#    Default: SQLite at ./data/dispatcher.db — mount that path or
#    every restart wipes it.
# ─────────────────────────────────────────────────────────────
# DISPATCHER_DB_DIALECT=mysql          # sqlite | mysql | postgres (default: sqlite)
# DISPATCHER_DB_URL=mysql://dispatcher:password@mysql:3306/dispatcher_state

# ...or discrete settings instead of a URL:
# DISPATCHER_DB_HOST=mysql
# DISPATCHER_DB_PORT=3306
# DISPATCHER_DB_USER=dispatcher
# DISPATCHER_DB_PASSWORD=
# DISPATCHER_DB_NAME=dispatcher_state

# ─────────────────────────────────────────────────────────────
# 5. Management API  (/api/v1/data-plane/*)
#    How the ScaleMargin platform reads health, variables,
#    campaigns and logs. Unset => the API is off, 503 on every
#    request. It never falls open.
#      Generate:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
# DISPATCHER_ATLAS_KEY=

# Browser origins allowed to call the API (comma-separated). Leave unset for
# server-to-server, which is the safe posture. "*" is accepted but warns at boot.
# DISPATCHER_ATLAS_CORS_ORIGINS=https://atlas.scalemargin.com

# Public origin of this deployment. Used for links and secure-cookie decisions.
# Falls back to UNSUBSCRIBE_URL_BASE, then localhost.
# DISPATCHER_PUBLIC_URL=https://dispatcher.example.com

# ─────────────────────────────────────────────────────────────
# 6. Unsubscribe and preference links
#    Public origin serving /api/unsubscribe and /api/preferences.
# ─────────────────────────────────────────────────────────────
UNSUBSCRIBE_URL_BASE=https://your-domain.com

# Full-endpoint overrides, only if they must differ from the paths above.
# UNSUBSCRIBE_LINK_URL=https://other-host.example/api/unsubscribe
# PREFERENCES_LINK_URL=https://other-host.example/api/preferences

# POST PII-free unsubscribed / preference_update analytics here.
# UNSUBSCRIBE_LINK_ANALYTICS_URL=https://your-host/api/webhooks/campaign-analytics/capture
# Redirect the browser after recording, instead of the built-in page.
# UNSUBSCRIBE_LINK_REDIRECT_URL=https://your-app.example/unsubscribed
# PREFERENCES_LINK_REDIRECT_URL=https://your-app.example/preferences-saved

# Logo on those pages.
# LOGO_URL=https://cdn.your-domain.com/logo.png

# Survey options: pipe-separated labels, id=label pairs, or a JSON array.
# Use id "other" for the free-text option. Sensible defaults if unset.
# UNSUBSCRIBE_REASONS=not_relevant=Not relevant|too_frequent=Too frequent|other=Other

# ─────────────────────────────────────────────────────────────
# 7. Event pipeline  (provider webhooks → ScaleMargin analytics)
#    Providers enable themselves from the keys in section 2:
#    SendGrid on SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY, Gupshup on
#    GUPSHUP_WEBHOOK_SECRET, SES always unless disabled.
# ─────────────────────────────────────────────────────────────
# EVENTS_CONFIG_PATH=./config/events.yaml

# HMAC secret for the Gupshup inbound webhook. Unset => that endpoint accepts
# unauthenticated payloads, so set it if the route is publicly reachable.
# GUPSHUP_WEBHOOK_SECRET=

# EVENT_PROVIDERS_DISABLED=sendgrid,ses,gupshup   # force off after auto-detect
# EVENT_PROVIDERS_ENABLED=gupshup                 # force on (keys still required)
# EVENT_DELIVERY_MODE=at_least_once               # at_least_once | best_effort
# EVENT_FORWARD_MODE=batched                      # batched | sync
# EVENT_BATCH_SIZE=100
# EVENT_BATCH_INTERVAL_MS=5000
# EVENT_BUFFER_DIR=./data/event-buffer            # set to buffer on disk
# EVENT_SENDGRID_INBOUND_EVENTS=default           # default | * | delivered,open
# EVENT_PREFERENCE_SIMULATION_LOG=0
# EVENT_DEBUG=1                                   # verbose boot + emit logs

# Retry budget before an outbox event is marked failed.
# DISPATCHER_OUTBOX_MAX_ATTEMPTS=10

# ─────────────────────────────────────────────────────────────
# 8. WhatsApp (Gupshup)
#    Outbound auth — use ONE of the two blocks.
# ─────────────────────────────────────────────────────────────
# --- io template API ---
# GUPSHUP_API_KEY=
# GUPSHUP_SRC_NAME=YourAppName
# GUPSHUP_SOURCE=918971741003          # WABA sender, digits only
# GUPSHUP_TEMPLATE_API_URL=https://api.gupshup.io/wa/api/v1/template/msg

# --- enterprise SendMessage ---
# GUPSHUP_USER_ID=
# GUPSHUP_PASSWORD=
# GUPSHUP_MESSAGE_TYPE=HSM
# GUPSHUP_TEMPLATE_LANGUAGE=en
# GUPSHUP_ENTERPRISE_API_URL=https://smsgupshup.com

# GUPSHUP_DEFAULT_TEMPLATE={"id":"<template-uuid>","params":["{{first_name}}"]}
# GUPSHUP_MEDIA_API_URL=https://mediaapi.smsgupshup.com/GatewayAPI/rest
# GUPSHUP_MEDIA_MSG_TYPE=IMAGE

# ─────────────────────────────────────────────────────────────
# 9. Image hosting (optional)
#    Unset => images are served from ScaleMargin's infrastructure.
# ─────────────────────────────────────────────────────────────
# IMAGE_STORAGE_PROVIDER=s3            # s3 | gcs | local (local = dev only)
# IMAGE_CDN_BASE_URL=https://cdn.your-domain.com

# --- S3 ---
# IMAGE_S3_BUCKET=
# IMAGE_S3_REGION=ap-south-1
# IMAGE_S3_PREFIX=campaign-images/

# --- GCS ---
# IMAGE_GCS_BUCKET=
# IMAGE_GCS_PREFIX=campaign-images/
# IMAGE_GCS_PROJECT_ID=
# IMAGE_GCS_CREDENTIALS_JSON=          # or use ADC on GCE/GKE

# ─────────────────────────────────────────────────────────────
# 10. Logging and retention
#     Logs persist to the state DB in section 4.
# ─────────────────────────────────────────────────────────────
# DISPATCHER_LOG_LEVEL=info            # trace|debug|info|warn|error
# DISPATCHER_LOG_RETENTION_DAYS=14
# DISPATCHER_LOG_MAX_ROWS=200000
# DISPATCHER_LOGS_API_TOKEN=           # bearer token for GET /logs

# dispatch_send_logs is one row per recipient per send — by far the largest
# table. Shortening this loses per-recipient detail; campaign_summary totals
# are never pruned.
# DISPATCHER_SEND_LOG_RETENTION_DAYS=30
# DISPATCHER_SEND_LOG_MAX_ROWS=1000000

# ─────────────────────────────────────────────────────────────
# 11. Admin console
#     NOT shipped in the released image — /admin returns 503 and
#     these do nothing there. They apply only to a locally built
#     console. Manage through the API in section 5 instead.
# ─────────────────────────────────────────────────────────────
# DISPATCHER_ADMIN_EMAIL=admin@scalemargins.tech
# DISPATCHER_ADMIN_PASSWORD=           # min 12 chars; else generated and logged once
# BETTER_AUTH_SECRET=                  # 32+ chars, or sessions reset on redeploy
# DISPATCHER_ADMIN_COOKIE_SECURE=false # only for an intentional HTTP deployment
# DISPATCHER_TRUSTED_ORIGINS=https://console.example.com

# ─────────────────────────────────────────────────────────────
# 12. Telemetry
#     Anonymous operational counts only — no PII, payloads,
#     secrets, ids or provider responses.
# ─────────────────────────────────────────────────────────────
# DISPATCHER_TELEMETRY_DISABLED=1
# DISPATCHER_TELEMETRY_DISTINCT_ID=    # stable anonymous id; hashed before sending
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ─────────────────────────────────────────────────────────────
# 13. Build metadata — set by CI, do not fill in by hand
# ─────────────────────────────────────────────────────────────
# DISPATCHER_VERSION=
# DISPATCHER_GIT_SHA=
# DISPATCHER_BUILD_TIME=
# DISPATCHER_IMAGE_TAG=

# ─────────────────────────────────────────────────────────────
# 14. Local development only
#     Test-harness variables live in docs/testing.md,
#     docs/ses.readme.md and docs/event-dual-secret-local-test.md.
# ─────────────────────────────────────────────────────────────
# DEV_RECIPIENT_EMAIL=test@example.com   # route ALL mail to one address
# LOCAL_DEV=1                            # insecure placeholder SCALEMARGIN_* secrets
# EVENT_TEST_CSV_PATH=./data/event-test-capture.csv
# EVENT_TEST_PUBLIC_BASE_URL=https://your-tunnel.example
# EVENT_TEST_KEEP_WORKDIR=1              # keep the harness working directory

# WhatsApp smoke test — pnpm run dev:gupshup-event-test
# GUPSHUP_EVENT_TEST_RECIPIENTS=919876543210   # route all WhatsApp sends here
# GUPSHUP_EVENT_TEST_SRC_NAME=
# GUPSHUP_EVENT_TEST_SOURCE=
# GUPSHUP_EVENT_TEST_CAPTION=
# GUPSHUP_EVENT_TEST_MEDIA_URL=
# GUPSHUP_EVENT_TEST_TEMPLATE=
# GUPSHUP_EVENT_TEST_LOG_PAYLOAD=0
# GUPSHUP_EVENT_TEST_CSV_PATH=./data/gupshup-event-test-capture.csv
# GUPSHUP_EVENT_TEST_SKIP_SEND=1         # start the server only, no template POST
# GUPSHUP_EVENT_TEST_OMIT_TAG=1          # drop the `tag` field if Gupshup rejects it
