# ═══════════════════════════════════════════════════════════════════════════
# ScaleMargin Dispatcher — .env.yaml
#
# The ONLY configuration file. There is no `.env`.
#
# Copy to `.env.yaml`, fill it in, and `chmod 600` it. Almost every key is
# optional — the dispatcher boots with sensible defaults and tells you at
# startup what it could not find. Three things are NOT optional:
#   - scalemargin.dispatch_secret / analytics_secret         (section 2)
#   - dispatcher.retention.message_id_ttl — no default       (section 1)
#
# Layout: `dispatcher:` is this service itself. Everything else is what it does.
#
# ⚠ THIS FILE HOLDS CREDENTIALS. It is covered by .gitignore and .dockerignore.
#   In Kubernetes mount it as a Secret with `defaultMode: 0400`, never a
#   ConfigMap.
#
# ── Precedence, highest first ──────────────────────────────────────────────
#   1. A real environment variable (Docker `environment:`, a k8s Secret, a
#      shell export). NEVER overwritten by this file, so a rotated secret
#      injected by your platform always wins.
#   2. A typed block below.
#   3. The `env:` passthrough map at the bottom.
#
# ── Two ways to write any secret ───────────────────────────────────────────
#   api_key: "sk_live_..."          the value itself
#   api_key_env: SENDGRID_API_KEY   the NAME of a variable holding it
#
#   The `_env` form keeps the secret out of this file. It needs the variable
#   to exist somewhere — your container's `environment:`, a k8s Secret, or
#   the `env:` map at the bottom of this file.
# ═══════════════════════════════════════════════════════════════════════════

version: 1

# ═══════════════════════════════════════════════════════════════════════════
# 1. DISPATCHER — THIS SERVICE
#
#    Everything about how the dispatcher itself runs: how it is reached, who
#    may reach it, its own database, admin auth, retention, logging and
#    telemetry. What it DOES — whose data it reads, how it sends, what goes in
#    a message — is in the top-level sections below.
# ═══════════════════════════════════════════════════════════════════════════
dispatcher:
  # ── How it is reached ────────────────────────────────────────────────────
  port: 3100
  public_url: https://dispatcher.your-company.com

  # ── Who may reach it ─────────────────────────────────────────────────────
  # The ScaleMargin platform's read credential. UNSET = the management API is
  # completely off (503 on every route). `openssl rand -base64 32`, then give
  # the same value to your ScaleMargin contact.
  atlas_key: "replace-with-a-32-char-random-string"
  # atlas_key_env: DISPATCHER_ATLAS_KEY

  # Browser origins allowed to call the management API. OMIT THIS KEY unless
  # told otherwise — no CORS headers means server-to-server only, which is the
  # safe default. `["*"]` is accepted but warns at boot.
  atlas_cors_origins:
    - https://atlas.scalemargin.com

  # Overrides the logs-API token managed from the console. Leave unset to use
  # the console-managed one.
  # logs_api_token: "replace-me"
  # logs_api_token_env: DISPATCHER_LOGS_API_TOKEN

  # ── Its own database ─────────────────────────────────────────────────────
  # Variables, campaign history, logs, the event outbox. NOT your customer
  # database — that is `user_lookup:` in section 3.
  database:
    dialect: postgres # sqlite | mysql | postgres
    host: postgres
    port: 5432
    user: dispatcher
    password: "replace-me" # must match POSTGRES_PASSWORD in docker-compose.yml
    # password_env: DISPATCHER_DB_PASSWORD
    database: dispatcher_state

    # A full URL instead, which wins over the discrete fields above:
    # url: postgres://dispatcher:secret@postgres:5432/dispatcher_state
    # url_env: DISPATCHER_DB_URL

    # For `dialect: sqlite` use a path instead of host/port/user/password.
    # Mount it, or every restart wipes your campaign history:
    # file: ./data/dispatcher.db

  # ── Admin console and session security ───────────────────────────────────
  admin:
    # Signs sessions. Generated and persisted on first boot if omitted — set it
    # explicitly in production so sessions survive a redeploy.
    auth_secret: "replace-with-a-32-char-random-string"
    # auth_secret_env: BETTER_AUTH_SECRET

    # Encrypts stored API keys. Changing it invalidates every existing key.
    # api_key_encryption_secret_env: DISPATCHER_API_KEY_ENCRYPTION_SECRET
    # api_key_encryption_secret: "…"

    # Seed account, created on first boot only.
    # email: operator@your-company.com
    # password_env: DISPATCHER_ADMIN_PASSWORD
    # password: "…"                  # at least 12 characters

    # Leave unset to infer from public_url. Force it only behind a proxy that
    # terminates TLS without setting X-Forwarded-Proto.
    # cookie_secure: true
    # trusted_origins:
    #   - https://console.your-company.com

    # Where the generated session secret and the first-boot login are written.
    # auth_secret_file: ./data/.better-auth-secret
    # credentials_file: ./data/initial-admin-credentials.txt

  # ── Retention ────────────────────────────────────────────────────────────
  # ⚠ message_id_ttl is MANDATORY. Everything else here has a default.
  retention:
    # How long provider message ids are kept in `provider_message_ids`, so you
    # can query them out of the dispatcher database and poll the provider for
    # status yourself.
    #
    # Format: a duration — "5d 2h", "12h", "30d". Minimum 1h.
    # The sweep runs hourly, so a row survives at most one tick past this
    # window: "2h" deletes rows between 2 and 3 hours old, never younger.
    #
    # There is deliberately NO default. Too short and the ids are gone before
    # you used them; too long and you are storing them forever.
    message_id_ttl: "5d 2h"

    # log_days: 14
    # log_max_rows: 200000
    # campaign_event_days: 90
    # campaign_event_max_rows: 500000
    # outbox_max_attempts: 10

  # ── Logging and telemetry ────────────────────────────────────────────────
  # logging:
  #   level: info                 # trace | debug | info | warn | error | fatal

  # telemetry:
  #   disabled: false             # true opts out of product analytics
  #   # A stable name for this deployment in product analytics. Hashed before
  #   # it is sent, so a hostname or client name is safe to use here.
  #   # distinct_id: acme-production
  #   # posthog_api_key: "phc_…"
  #   # posthog_api_key_env: POSTHOG_API_KEY
  #   # posthog_host: https://eu.posthog.com

# ═══════════════════════════════════════════════════════════════════════════
# 2. SCALEMARGIN — platform credentials (REQUIRED)
#    From your onboarding email. The dispatcher will not start without them.
# ═══════════════════════════════════════════════════════════════════════════
scalemargin:
  dispatch_secret: "replace-me"
  analytics_secret: "replace-me"
  # dispatch_secret_env: SCALEMARGIN_DISPATCH_SECRET
  # analytics_secret_env: SCALEMARGIN_ANALYTICS_SECRET
  # analytics_callback_url: https://api.scalemargin.com/analytics

# ═══════════════════════════════════════════════════════════════════════════
# 3. USER LOOKUP — where recipient data comes from. PICK ONE MODE.
#
#    Omit this block entirely and the dispatcher runs in MOCK mode: it
#    personalizes with invented data and mails nobody real, while looking
#    perfectly healthy. That is the most damaging misconfiguration here,
#    because nothing errors. Check with:
#      curl -H "Authorization: Bearer $KEY" localhost:3100/api/v1/data-plane/state | jq .lookup
# ═══════════════════════════════════════════════════════════════════════════

# ── mode: database — you grant a read-only user ────────────────────────────
user_lookup:
  mode: database
  backend: postgres # postgres | mysql | sqlite

  connection:
    host: db.internal
    port: 5432
    user: dispatcher_ro
    password: "replace-me"
    # password_env: DB_PASSWORD
    database: customers
    ssl: true
    # sqlite instead:
    # file: ./data/customers.sqlite

  source:
    kind: view # table | view — a view is usually the better answer
    name: dispatcher_recipients
    id_column: external_id # holds the ID ScaleMargin sends
    id_type: string # string | int | bigint | uuid

  # Your column for each contact field — the lookup returns nothing else.
  # `email` is required to send email; `phone` to send WhatsApp.
  # Names, company etc. are `field` variables, which read any other column of
  # `source` (only the ones in use). The view is your allow-list.
  fields:
    email: email_address
    phone: mobile_number

  batch:
    max_ids_per_query: 1000
    dedupe: true

# ── mode: network — your API resolves them, we never touch your database ───
# We POST { "user_ids": [...], "channel": "email", "fields": [...] }
# You return  { "users": [{ "user_id": "...", "email": "..." }] }
# Full contract: docs/user-lookup-network-contract.md
#
# user_lookup:
#   mode: network
#   network:
#     url: https://api.your-company.com/scalemargin/lookup
#     token: "the-bearer-token"
#     # token_env: LOOKUP_API_TOKEN
#     timeout_ms: 3000
#     retries: 2            # 5xx and timeouts only; 4xx is never retried
#   fields:                 # email and phone only (others ignored, with a warning);
#                           # the right-hand side is YOUR name.
#                           # email sends ask for email, WhatsApp sends for phone
#     email: email
#     phone: phone
#   batch:
#     max_ids_per_query: 500
#     dedupe: true
#
# NOTE: `field` and `query` variables need your database, so they cannot
# resolve in network mode. The dispatcher refuses to create them and the
# platform hides both options. Personalize with api / computed / constant.

# ── mode: mock — local development only ────────────────────────────────────
# user_lookup:
#   mode: mock

# ═══════════════════════════════════════════════════════════════════════════
# 4. SENDING
#
#    EITHER the `email:` shorthand below for one account, OR the full
#    `senders:` list in section 5 for several. `senders:` wins if both exist.
# ═══════════════════════════════════════════════════════════════════════════
email:
  provider: ses # ses | sendgrid
  from: campaigns@your-company.com # MUST be verified with your provider
  reply_to: support@your-company.com

# ═══════════════════════════════════════════════════════════════════════════
# 5. SENDERS — several accounts, with weights and failover (optional)
#    Delete this whole section if section 4 is enough.
# ═══════════════════════════════════════════════════════════════════════════
routing:
  failover:
    max_attempts: 2 # total attempts per recipient, across senders
    on_timeout: false # ambiguous outcome → do NOT resend (avoids duplicates)
    on_identity_error: false # an unverified sender is config rot, not a blip
    breaker:
      failure_threshold: 5 # consecutive failures before a sender is parked
      cooldown_ms: 60000
  default_sender:
    email: primary-ses
    whatsapp: primary-wa

senders:
  - id: primary-ses
    channel: email
    provider: ses
    organizations: ["*"] # ["*"] = every org, or ["org_1", "org_2"]
    from: campaigns@your-company.com
    reply_to: support@your-company.com
    weight: 3 # roughly 3x the traffic of a weight-1 sender; 0 = pin-only
    enabled: true
    ses:
      region: ap-south-1
      configuration_set: ses-events # required for open/click/bounce tracking
      access_key_id_env: AWS_ACCESS_KEY_ID
      secret_access_key_env: AWS_SECRET_ACCESS_KEY
      # Or inline, instead of the two _env lines above. Omit all four to use
      # an IAM role (recommended on EC2/ECS/EKS):
      # access_key_id: "AKIA…"
      # secret_access_key: "…"

    # Per-sender override of routing.failover.max_attempts. This is the ONLY
    # failover setting honoured per sender — on_timeout and on_identity_error
    # are global and must be set under routing.failover above.
    # failover:
    #   max_attempts: 3

  # - id: backup-sendgrid
  #   channel: email
  #   provider: sendgrid
  #   organizations: ["*"]
  #   from: campaigns@your-company.com
  #   weight: 1
  #   enabled: true
  #   sendgrid:
  #     api_key_env: SENDGRID_API_KEY
  #     event_webhook_public_key_env: SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY
  #     # or inline:
  #     # api_key: "SG.…"
  #     # event_webhook_public_key: "…"   # base64 ECDSA key from the Event Webhook page

  # - id: primary-wa
  #   channel: whatsapp
  #   provider: gupshup
  #   organizations: ["*"]
  #   weight: 1
  #   enabled: true
  #   gupshup:
  #     # The credentials you supply decide the mode, not `mode:` itself:
  #     # an api key → API-key mode; user_id + password → enterprise mode.
  #     # If both are present the api key wins. `mode:` is informational.
  #     mode: api_key           # api_key | enterprise
  #
  #     # API-key mode
  #     api_key_env: GUPSHUP_API_KEY
  #     # api_key: "…"
  #
  #     # Enterprise mode — use these INSTEAD of an api key
  #     # user_id_env: GUPSHUP_USER_ID
  #     # user_id: "2000123456"
  #     # password_env: GUPSHUP_PASSWORD
  #     # password: "…"
  #
  #     src_name: YourAppName
  #     source: "919999999999"  # sender number, digits only
  #     default_template: welcome_v1
  #     template_language: en
  #     message_type: HSM
  #     webhook_secret_env: GUPSHUP_WEBHOOK_SECRET
  #     # webhook_secret: "…"
  #
  #     # Endpoint overrides — only if Gupshup has given you different hosts:
  #     # template_api_url: https://api.gupshup.io/wa/api/v1/template/msg   # default
  #     # enterprise_api_url: https://smsgupshup.com                         # default

  # - id: freshchat-wa
  #   channel: whatsapp
  #   provider: freshchat
  #   organizations: ["*"]
  #   weight: 1
  #   enabled: true
  #   freshchat:
  #     api_key_env: FRESHCHAT_API_KEY
  #     # api_key: "…"
  #
  #     # The WhatsApp number you send from, digits only.
  #     source: "919999999999"
  #     # source_env: FRESHCHAT_SOURCE
  #     # Older names for `source`, still accepted. `source` wins if both are set:
  #     # from_number: "919999999999"
  #     # from_number_env: FRESHCHAT_FROM_NUMBER
  #
  #     template_api_url: https://your-org.freshchat.com/v2/outbound-messages/whatsapp
  #     # Older name for template_api_url, still accepted:
  #     # api_endpoint: https://your-org.freshchat.com/v2/outbound-messages/whatsapp
  #     # Reads the URL from a variable — the only way to, since
  #     # template_api_url has no _env form:
  #     # api_endpoint_env: FRESHCHAT_OUTBOUND_MESSAGES_URL
  #
  #     namespace_env: FRESHCHAT_NAMESPACE
  #     # namespace: "…"
  #     default_template: welcome_v1
  #     template_language: en
  #     webhook_secret_env: FRESHCHAT_WEBHOOK_SECRET
  #     # webhook_secret: "…"

# ═══════════════════════════════════════════════════════════════════════════
# 6. LINKS embedded in messages
# ═══════════════════════════════════════════════════════════════════════════
links:
  unsubscribe_url_base: https://dispatcher.your-company.com
  # logo_url: https://cdn.your-company.com/logo.png
  # unsubscribe_redirect_url: https://your-company.com/goodbye
  # preferences_redirect_url: https://your-company.com/preferences
  # unsubscribe_analytics_url: https://api.scalemargin.com/unsubscribe

  # Survey options on the unsubscribe page. Omit for the built-in defaults.
  # unsubscribe_reasons:
  #   - Too many emails
  #   - Not relevant to me
  #   - I never signed up

# ═══════════════════════════════════════════════════════════════════════════
# 7. EVENTS — inbound provider webhooks, outbound forwarding (optional)
# ═══════════════════════════════════════════════════════════════════════════
# events:
#   forward_mode: batched            # batched | sync — sync forwards each event before responding
#   delivery_mode: at_least_once     # at_least_once | best_effort
#   batch_size: 100
#   batch_interval_ms: 5000
#   buffer_dir: ./data/events
#   sendgrid_inbound_events: "*"     # or: [delivered, open, click, bounce]
#   providers_enabled: [ses, sendgrid]
#   providers_disabled: []
#   debug: false
#   config_path: ./config/events.yaml  # where the events config file lives

# ═══════════════════════════════════════════════════════════════════════════
# 8. IMAGE STORAGE — where campaign images live (optional)
# ═══════════════════════════════════════════════════════════════════════════
# storage:
#   provider: local                  # local | s3 | gcs
#   local_dir: ./public/images
#   local_base_url: https://dispatcher.your-company.com/images
#
#   # provider: s3
#   # s3_bucket: my-campaign-images
#   # s3_region: ap-south-1
#   # s3_prefix: dispatcher/
#   # cdn_base_url: https://cdn.your-company.com
#
#   # provider: gcs
#   # gcs_bucket: my-campaign-images
#   # gcs_project_id: my-project
#   # gcs_prefix: dispatcher/
#   # gcs_credentials_json_env: IMAGE_GCS_CREDENTIALS_JSON
#   # gcs_credentials_json: '{"type":"service_account",…}'   # or inline

# ═══════════════════════════════════════════════════════════════════════════
# 9. env — the escape hatch
#
#     Anything not modelled above, set verbatim. This is where the targets of
#     the `_env:` references used elsewhere in this file can live, now that
#     there is no `.env`.
#
#     LOWEST precedence: a real environment variable wins, and so does a typed
#     block above. A collision with a typed block is reported at boot.
# ═══════════════════════════════════════════════════════════════════════════
env:
  AWS_ACCESS_KEY_ID: "replace-me"
  AWS_SECRET_ACCESS_KEY: "replace-me"
  # SENDGRID_API_KEY: "SG.replace-me"
  # SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY: "replace-me"
  # GUPSHUP_API_KEY: "replace-me"
  # GUPSHUP_WEBHOOK_SECRET: "replace-me"
  # FRESHCHAT_API_KEY: "replace-me"
  # FRESHCHAT_NAMESPACE: "replace-me"
  # FRESHCHAT_WEBHOOK_SECRET: "replace-me"
