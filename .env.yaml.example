  #   channel: whatsapp
  #   provider: gupshup
  #   organizations: ["*"]
  #   weight: 1
  #   enabled: true
  #   gupshup:
  #     mode: api_key           # api_key | enterprise
  #     api_key_env: GUPSHUP_API_KEY
  #     src_name: MyAppBot
