# ScaleMargin Dispatcher — .env.yaml
#
# Copy to .env.yaml, next to .env at the repository root.
#
# Three things live here:
#   dispatcher:   how this deployment is reached, and who may reach it
#   user_lookup:  where recipient data comes from
#   senders:      which accounts send, with weights and failover
#
# ⚠ THIS FILE HOLDS CREDENTIALS. `chmod 600 .env.yaml`. It is already covered
#   by .gitignore and .dockerignore; in Kubernetes mount it as a Secret with
#   defaultMode 0400, never a ConfigMap.

version: 1

# ═════════════════════════════════════════════════════════════
# DISPATCHER — this deployment's own identity and access
# ═════════════════════════════════════════════════════════════
#
# Every key here is optional. Omit the block entirely and all four settings
# come from the environment (PORT, DISPATCHER_PUBLIC_URL, DISPATCHER_ATLAS_KEY,
# DISPATCHER_ATLAS_CORS_ORIGINS) exactly as before — those still work and are
# not deprecated.
#
# Precedence is per KEY here, unlike user_lookup.connection which is per file:
# these are independent scalars, so taking `port` from the environment while
# `atlas_key` lives here is ordinary rather than a half-migration.

dispatcher:
  port: 3100
  public_url: https://dispatcher.your-company.com

  # The ScaleMargin platform's read credential. UNSET IN BOTH PLACES = the
  # management API is completely off (503 on every route). Generate with
  # `openssl rand -base64 32`, then give the same value to your contact.
  atlas_key: "paste-the-key-here" # or: atlas_key_env: DISPATCHER_ATLAS_KEY

  # Browser origins allowed to call the management API. Omit the key entirely
  # unless told otherwise: no CORS headers means only server-to-server calls
  # work, which is the safe default. `["*"]` is accepted but warns at boot.
  # A comma-separated string is accepted too, for anyone pasting the old
  # environment variable.
  atlas_cors_origins:
    - https://atlas.scalemargin.com

# ═════════════════════════════════════════════════════════════
# USER LOOKUP — pick ONE mode
# ═════════════════════════════════════════════════════════════
#
# Placeholders are NOT configured here. Variables live in the dispatcher's own
# database and are edited through the ScaleMargin platform. This block only
# says where the contact data (email, phone) is read from.

# ---------------- mode: database — you hold the data ----------------
user_lookup:
  mode: database
  backend: postgres # postgres | mysql | sqlite

  # Read-only credentials for YOUR customer database.
  # Omit this block entirely to keep using DB_* from .env (deprecated).
  connection:
    host: db.internal
    port: 5432
    user: dispatcher_ro
    password: "paste-the-password-here" # or: password_env: DB_PASSWORD
    database: customers
    ssl: true
    # sqlite instead:
    # file: ./data/dispatch.sqlite

  source:
    kind: table # table | view
    name: customers
    id_column: external_id # holds the ID ScaleMargin sends
    id_type: string # string | int | bigint | uuid

  # Logical name → your column. Only these columns are ever read.
  # `email` is required to send email; `phone` to send WhatsApp.
  fields:
    email: email_address
    phone: mobile_number
    first_name: given_name
    last_name: family_name
    company_name: account_name

  batch:
    max_ids_per_query: 1000
    dedupe: true

# ---------------- mode: network — your API resolves them ----------------
# We POST { "user_ids": [...], "fields": [...] } and you return
# { "users": [{ "user_id": "...", "email": "...", ... }] }.
# Full contract: docs/user-lookup-network-contract.md
#
# user_lookup:
#   mode: network
#   network:
#     url: https://api.your-company.com/scalemargin/lookup
#     token: "paste-the-bearer-token-here"   # or: token_env: LOOKUP_API_TOKEN
#     timeout_ms: 3000
#     retries: 2
#   fields:              # exactly the names we ask you for
#     email: email
#     phone: phone
#     first_name: first_name
#   batch:
#     max_ids_per_query: 500
#     dedupe: true
#
# NOTE: `source: query` variables need a SQL connection, so they cannot resolve
# in network mode. The dispatcher refuses to create them and the platform hides
# the option.

# ---------------- mode: mock — local development only ----------------
# Fabricates recipients. Reads nothing, mails nobody real.
#
# user_lookup:
#   mode: mock

# ═════════════════════════════════════════════════════════════
# SENDERS
# ═════════════════════════════════════════════════════════════

routing:
  failover:
    max_attempts: 2           # total send attempts per recipient across senders
    on_timeout: false         # ambiguous outcome -> do NOT resend (avoids duplicates)
    on_identity_error: false  # unverified sender is configuration rot, not a transient
    breaker:
      failure_threshold: 5    # consecutive transient failures -> breaker opens
      cooldown_ms: 60000      # 1 minute cooldown before half-open probe
  default_sender:
    email: default-ses
    whatsapp: default-wa

# A value ending in `_env` names a variable in .env; without the suffix the
# value is used literally. `api_key: SENDGRID_API_KEY` sets your key to that
# literal text and fails on the first send.
senders:
  # ---------------- Email Senders ----------------
  - id: default-ses
    channel: email
    provider: ses
    organizations: ["*"]      # ["*"] = all organizations, or specify ["org_1", "org_2"]
    from: "noreply@example.com"
    reply_to: "support@example.com"
    weight: 1                 # relative weight for automatic HRW selection; 0 = pin-only
    enabled: true
    ses:
      region: ap-south-1
      configuration_set: ses-events  # required for SNS event tracking
      access_key_id_env: AWS_ACCESS_KEY_ID
      secret_access_key_env: AWS_SECRET_ACCESS_KEY

  # - id: marketing-sendgrid
  #   channel: email
  #   provider: sendgrid
  #   organizations: ["*"]
  #   from: "marketing@example.com"
  #   weight: 1
  #   enabled: true
  #   sendgrid:
  #     api_key_env: SENDGRID_API_KEY
  #     event_webhook_public_key_env: SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY

  # ---------------- WhatsApp Senders ----------------
  # - id: default-wa
  #   channel: whatsapp
  #   provider: gupshup
  #   organizations: ["*"]
  #   weight: 1
  #   enabled: true
  #   gupshup:
  #     mode: api_key           # api_key | enterprise
  #     api_key_env: GUPSHUP_API_KEY
  #     src_name: MyAppBot
  #     source: "919999999999"
  #     default_template: welcome_v1
  #     template_language: en
  #     message_type: HSM
  #     webhook_secret_env: GUPSHUP_WEBHOOK_SECRET

  # - id: freshchat-wa
  #   channel: whatsapp
  #   provider: freshchat
  #   organizations: ["*"]
  #   weight: 1
  #   enabled: true
  #   freshchat:
  #     mode: api_key
  #     api_key_env: FRESHCHAT_API_KEY
  #     source: "919999999999"
  #     template_api_url: "https://api.freshchat.com/v2/outbound-messages/whatsapp"
  #     namespace_env: FRESHCHAT_NAMESPACE
  #     default_template: welcome_v1
  #     template_language: en
  #     webhook_secret: your_freshchat_webhook_secret
