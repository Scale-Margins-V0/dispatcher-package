{
  "name": "scalemargin-dispatch-handler",
  "version": "0.2.3",
  "description": "Reference implementation for ScaleMargin webhook dispatch handler and analytics reporter. Supports AWS SES and SendGrid.",
  "packageManager": "pnpm@9.15.4",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:admin": "vite --config vite.config.ts",
    "dev:local": "LOCAL_DEV=1 tsx watch src/index.ts",
    "dev:http-profile-mock": "tsx scripts/http-profile-mock-server.ts",
    "dev:event-test": "tsx scripts/event-dual-secret-test-server.ts",
    "dev:ses-event-test": "tsx scripts/ses-dual-secret-test-server.ts",
    "dev:event-test:images": "EVENT_TEST_INCLUDE_IMAGES=1 tsx scripts/event-dual-secret-test-server.ts",
    "dev:ses-event-test:images": "EVENT_TEST_INCLUDE_IMAGES=1 tsx scripts/ses-dual-secret-test-server.ts",
    "dev:gupshup-event-test": "tsx scripts/gupshup-dual-secret-test-server.ts",
    "dev:scalemargin": "./scripts/dev-scalemargin.sh",
    "dev:mock-user-lookup": "tsx scripts/mock-user-lookup.ts",
    "build": "pnpm run build:server && pnpm run build:admin",
    "build:server": "tsc",
    "build:admin": "tsc -p admin/tsconfig.json && vite build --config vite.config.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset tag",
    "db:generate": "drizzle-kit generate --config drizzle.config.sqlite.ts && drizzle-kit generate --config drizzle.config.mysql.ts && drizzle-kit generate --config drizzle.config.pg.ts",
    "seed:mysql": "tsx scripts/seed/seed.ts --dialect=mysql",
    "seed:postgres": "tsx scripts/seed/seed.ts --dialect=postgres",
    "seed:sqlite": "tsx scripts/seed/seed.ts --dialect=sqlite",
    "seed:sqlite:scalemargin": "tsx scripts/seed/seed-scalemargin.ts",
    "seed:campaigns": "tsx scripts/seed-campaign-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@google-cloud/storage": "^7.14.0",
    "@sendgrid/eventwebhook": "^8.0.0",
    "@sendgrid/mail": "^8.1.4",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^11.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "posthog-node": "^5.35.5",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "starkbank-ecdsa": "^1.1.1",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.4",
    "vitest": "^3.0.4"
  }
}
